# 유챔 가호 계산기 서버 설정. 이 파일을 .env로 복사해서 쓴다(.env는 커밋하지 않는다).

# 이 PC 안에서만 열려면 127.0.0.1. 같은 공유기의 다른 기기에서도 열려면 0.0.0.0(Windows 방화벽에서 포트를 열어야 한다).
HOST=127.0.0.1
# maple-market(3000)·maple-hunt(3200, 3201)·maple-Scheduler(3300)와 겹치지 않는 포트.
PORT=3400
# 주소 앞부분. 19991115.xyz/gaho/에서 연다. 바꾸면 터널의 경로 규칙도 같이 바꾼다.
BASE_PATH=/gaho

# 넥슨 Open API 키(openapi.nexon.com에서 애플리케이션 등록 후 발급). 캐릭터 이미지·레벨·직업을 가져온다.
# maple-hunt의 .env와 같은 키를 써도 된다. 비워 두면 계산은 되고 캐릭터 이미지만 꺼진다.
NEXON_API_KEY=""
# 이 계산기가 하루(한국 날짜)에 넥슨 API를 부르는 최대 횟수. 캐릭터 1명 조회에 2건 든다. 같은 키를 쓰는 maple-hunt 몫을 남겨 둔다.
NEXON_DAILY_LIMIT=300
